<Project>

  <!--
    ============================================================================
    GERENCIAMENTO CENTRAL DE PACOTES (Central Package Management - CPM)
    ============================================================================

    Com "ManagePackageVersionsCentrally", os arquivos .csproj declaram APENAS o
    nome do pacote (<PackageReference Include="MediatR" />) e a versão vem daqui.

    Por que isso importa numa solução com 19 projetos:
      - Impede "version drift": dois serviços usando EF Core 10.0.4 e 10.0.11
        compilam, mas divergem em runtime e geram bugs difíceis de reproduzir.
      - Atualizar uma dependência (ex.: por um CVE) vira uma única linha alterada
        em vez de uma caçada por todos os .csproj.
      - Dá um ponto único para auditar licenças e vulnerabilidades.

    Auditoria de vulnerabilidades: veja o alvo `audit` documentado no README
    (dotnet list package, com as flags de vulnerabilidade e de pacotes transitivos).
    ============================================================================
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Faz o build FALHAR quando o NuGet detecta um pacote com vulnerabilidade
      conhecida de severidade alta ou crítica. Sem isso, o aviso NU1903 passa
      despercebido no meio de centenas de linhas de log.
      Vulnerabilidades moderadas/baixas continuam como aviso, para não travar o
      desenvolvimento por algo que ainda não tem correção publicada.
    -->
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup Label="Aplicação - CQRS, validação e mensageria">
    <!--
      MediatR fica fixado na linha 12.x de propósito: a partir da versão 13 o
      projeto passou a exigir licença comercial acima de um teto de faturamento.
      A 12.4.1 é a última sob licença Apache 2.0.
    -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!--
      Mesma situação do MediatR: MassTransit 9.x é comercial; a linha 8.5.x
      continua Apache 2.0 e recebe correções.
    -->
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
  </ItemGroup>

  <ItemGroup Label="Persistência">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="StackExchange.Redis" Version="2.8.37" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core e segurança">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="Polly" Version="8.5.2" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="gRPC (comunicação síncrona entre serviços)">
    <PackageVersion Include="Google.Protobuf" Version="3.29.3" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.76.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.76.0" />
  </ItemGroup>

  <ItemGroup Label="Observabilidade (OpenTelemetry)">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <!--
    ============================================================================
    CORREÇÕES DE DEPENDÊNCIAS TRANSITIVAS
    ============================================================================
    Os pacotes abaixo não são referenciados diretamente por nenhum projeto: eles
    chegam "de carona" através de outras dependências. Como o NuGet resolve
    conflitos escolhendo a MAIOR versão exigida, declarar a versão corrigida aqui
    força o upgrade sem precisar esperar o pacote-pai publicar uma release.

    É o equivalente .NET ao "resolutions"/"overrides" do npm.
    ============================================================================
  -->
  <ItemGroup Label="Overrides de segurança (dependências transitivas)">
    <!-- GHSA-v5pm-xwqc-g5wc: DoS na leitura de documentos OpenAPI. Vem de Microsoft.AspNetCore.OpenApi. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.10.0" />
  </ItemGroup>

</Project>
